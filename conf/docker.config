// ============================================================
// conf/docker.config - Docker container configuration
// ============================================================
// Container images are pinned to specific versions for reproducibility.
// Recommendation: Use Biocontainers where available for provenance.

process {
    withName: 'PAIR_FASTQS|VALIDATE_ASSOCIATION|READ_RETENTION_SUMMARY|MAKE_MQC_CUSTOM|VERSION_LOG' {
        container = 'quay.io/biocontainers/python:3.11'
    }
    withName: 'FASTQC.*' {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }
    withName: 'MULTIQC.*' {
        container = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }
    withName: 'CUTADAPT' {
        container = 'quay.io/biocontainers/cutadapt:4.7--py39hf95cd2a_1'
    }
    withName: 'BOWTIE2_ALIGN' {
        container = 'quay.io/biocontainers/bowtie2:2.5.3--py39h6fed5c7_0'
    }
    withName: 'SAMTOOLS.*' {
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
    }
    withName: 'FILTER_MITO|FILTER_BLACKLIST' {
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
    }
    withName: 'PICARD_MARKDUPLICATES' {
        container = 'quay.io/biocontainers/picard:3.1.1--hdfd78af_0'
    }
    withName: 'UMI_TOOLS_DEDUP' {
        container = 'quay.io/biocontainers/umi_tools:1.1.5--py39hf95cd2a_0'
    }
    withName: 'BAMCOVERAGE.*|COMPUTE_MATRIX.*|PLOT_PROFILE|PLOT_HEATMAP' {
        container = 'quay.io/biocontainers/deeptools:3.5.4--pyhdfd78af_1'
    }
    withName: 'MACS3_CALLPEAK.*' {
        container = 'quay.io/biocontainers/macs3:3.0.1--py39hf95cd2a_0'
    }
    withName: 'MERGE_BAMS' {
        container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'
    }
    withName: 'ANNOTATE_PEAKS' {
        // ChIPseeker requires R + Bioconductor
        container = 'quay.io/biocontainers/bioconductor-chipseeker:1.38.0--r43hdfd78af_0'
    }
    withName: 'FRIP_SCORE' {
        container = 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_1'
    }
}
