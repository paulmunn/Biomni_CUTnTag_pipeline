// ============================================================
// conf/test.config - Minimal test profile
// ============================================================
// Uses synthetic/minimal data for CI testing.
// Run: nextflow run main.nf -profile test,docker

params {
    // Minimal resource limits for CI
    max_cpus   = 2
    max_memory = 6.GB
    max_time   = 2.h

    // Test data (relative to pipeline root; generate with bin/make_test_data.py)
    input_dir       = "${projectDir}/test_data/fastq"
    outdir          = "test_results"
    genome          = "hg38_chr21"
    bowtie2_index   = "${projectDir}/test_data/index/hg38_chr21"
    chrom_sizes     = "${projectDir}/test_data/hg38_chr21.chrom.sizes"
    blacklist       = "${projectDir}/test_data/hg38_chr21_blacklist.bed"
    annotation_gtf  = "${projectDir}/test_data/hg38_chr21.gtf"
    tss_bed         = "${projectDir}/test_data/hg38_chr21_tss.bed"
    association_csv = "${projectDir}/test_data/test_association.csv"

    // Reduced parameters for speed
    threads         = 2
    bigwig_binsize  = 50
    tss_window      = 1000
    peak_center_window = 500
    macs3_genome    = "hs"
    allow_no_control = false
}
