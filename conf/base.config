// ============================================================
// conf/base.config - Base resource configuration
// ============================================================

params {
    // Maximum resource limits (override per-cluster in slurm.config)
    max_memory = 128.GB
    max_cpus   = 32
    max_time   = 240.h
}

process {
    // Default shell
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Per-process resource overrides
    withName: 'PAIR_FASTQS' {
        label = 'process_single'
    }
    withName: 'VALIDATE_ASSOCIATION' {
        label = 'process_single'
    }
    withName: 'FASTQC.*' {
        label = 'process_low'
        cpus  = { check_max( 2, 'cpus' ) }
    }
    withName: 'MULTIQC.*' {
        label = 'process_low'
    }
    withName: 'CUTADAPT' {
        label = 'process_low'
        cpus  = { check_max( 4 * task.attempt, 'cpus' ) }
    }
    withName: 'BOWTIE2_ALIGN' {
        label  = 'process_medium'
        cpus   = { check_max( 8  * task.attempt, 'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h  * task.attempt, 'time'   ) }
    }
    withName: 'SAMTOOLS.*' {
        label = 'process_low'
        cpus  = { check_max( 4, 'cpus' ) }
    }
    withName: 'FILTER_MITO' {
        label = 'process_low'
    }
    withName: 'FILTER_BLACKLIST' {
        label = 'process_low'
    }
    withName: 'PICARD_MARKDUPLICATES' {
        label  = 'process_medium'
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: 'UMI_TOOLS_DEDUP' {
        label  = 'process_medium'
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: 'BAMCOVERAGE.*' {
        label = 'process_medium'
        cpus  = { check_max( 8, 'cpus' ) }
    }
    withName: 'COMPUTE_MATRIX.*' {
        label  = 'process_high'
        cpus   = { check_max( 12, 'cpus' ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
    }
    withName: 'PLOT_PROFILE' {
        label = 'process_low'
    }
    withName: 'PLOT_HEATMAP' {
        label = 'process_low'
    }
    withName: 'MACS3_CALLPEAK.*' {
        label  = 'process_medium'
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: 'MERGE_BAMS' {
        label  = 'process_medium'
        cpus   = { check_max( 8, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: 'ANNOTATE_PEAKS' {
        label  = 'process_medium'
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: 'FRIP_SCORE' {
        label = 'process_low'
    }
    withName: 'READ_RETENTION_SUMMARY' {
        label = 'process_single'
    }
    withName: 'MAKE_MQC_CUSTOM' {
        label = 'process_single'
    }
    withName: 'VERSION_LOG' {
        label = 'process_single'
    }
}
