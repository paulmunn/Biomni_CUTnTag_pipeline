// ============================================================
// conf/slurm.config - SLURM HPC configuration
// ============================================================

params {
    max_memory = 256.GB
    max_cpus   = 64
    max_time   = 240.h
}

process {
    executor       = 'slurm'
    clusterOptions = { "--account=${params.slurm_account ?: ''}" }
    queue          = params.slurm_queue ?: 'normal'

    // SLURM-specific overrides
    withLabel: process_single {
        cpus   = 1
        memory = 4.GB
        time   = 2.h
    }
    withLabel: process_low {
        cpus   = 4
        memory = 16.GB
        time   = 6.h
    }
    withLabel: process_medium {
        cpus   = 8
        memory = 32.GB
        time   = 12.h
    }
    withLabel: process_high {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
    }
    withLabel: process_long {
        time   = 48.h
    }
}

// Optional: SLURM account and queue parameters
params {
    slurm_account = null
    slurm_queue   = 'normal'
}
